ARG BASE_IMAGE_REGISTRY=ghcr.io/flavioheleno/php-ext-farm
ARG DEBIAN_VERSION=bookworm
FROM ${BASE_IMAGE_REGISTRY}/debian:${DEBIAN_VERSION}

# OCI Image Labels
ARG BUILD_DATE
ARG PHP_VERSION
ARG TARGETARCH
ARG TARGETVARIANT
LABEL org.opencontainers.image.url="https://github.com/flavioheleno/php-ext-farm" \
      org.opencontainers.image.source="https://github.com/flavioheleno/php-ext-farm/blob/main/docker/base/php/Dockerfile.debian" \
      org.opencontainers.image.created="${BUILD_DATE}" \
      org.opencontainers.image.title="PHP ${PHP_VERSION} on Debian ${DEBIAN_VERSION}" \
      org.opencontainers.image.description="Custom PHP ${PHP_VERSION} base image for ${TARGETARCH}${TARGETVARIANT} built from source for extension compilation" \
      org.opencontainers.image.vendor="php-ext-farm" \
      org.opencontainers.image.licenses="MIT"

SHELL ["/bin/bash", "-eo", "pipefail", "-c"]

# Arguments for PHP version
ARG PHP_VERSION_TAG
ARG PHP_VERSION_SHA256
ARG PHP_VERSION_BRANCH=master

# Build PHP from source
WORKDIR /usr/src/php
RUN if [ -n "${PHP_VERSION_TAG}" ]; then \
      # Download official tarball for releases (much faster than git clone)
      echo "Downloading PHP ${PHP_VERSION_TAG} from php.net..." && \
      curl -fsSL "https://www.php.net/distributions/${PHP_VERSION_TAG}.tar.xz" -o php.tar.xz && \
      \
      # Verify SHA256 checksum
      echo "${PHP_VERSION_SHA256}  php.tar.xz" | sha256sum -c - && \
      \
      # Extract tarball
      tar -xf php.tar.xz --strip-components=1 && \
      rm php.tar.xz; \
    else \
      # Use git for development versions (next/master)
      echo "Cloning PHP from branch ${PHP_VERSION_BRANCH}..." && \
      git clone --depth 1 --branch "${PHP_VERSION_BRANCH}" https://github.com/php/php-src.git .; \
    fi && \
    export CFLAGS="-fstack-protector-strong -fpic -fpie -O2 -D_LARGEFILE_SOURCE -D_FILE_OFFSET_BITS=64" && \
    export CXXFLAGS="${CFLAGS}" && \
    export LDFLAGS="-Wl,-O1 -pie" && \
    ./buildconf --force && \
    ./configure \
      --prefix=/usr/local \
      --enable-cli \
      --with-config-file-path=/usr/local/etc/php \
      --with-config-file-scan-dir=/usr/local/etc/php/conf.d \
      --disable-cgi \
      --disable-phpdbg \
      --disable-phar \
      --disable-fpm \
      --enable-mbstring \
      --enable-mysqlnd \
      --enable-opcache \
      --enable-pcntl \
      --enable-sockets \
      --with-curl \
      --with-openssl \
      --with-readline \
      --with-sodium \
      --with-zlib && \
    make -j"$(nproc)" && \
    find -type f -name '*.a' -delete && \
    make install && \
    mkdir -p /usr/local/etc/php/conf.d && \
    php --version && \
    php -m && \
    strip --strip-all /usr/local/bin/php /usr/local/bin/phpize /usr/local/bin/php-config 2>/dev/null || true && \
    rm -rf /usr/src/php

# Set up working directory for extension builds
WORKDIR /tmp/extension
