ARG BASE_IMAGE_REGISTRY=ghcr.io/flavioheleno/php-ext-farm
ARG PHP_VERSION=8.3
ARG ALPINE_VERSION=3.20
FROM ${BASE_IMAGE_REGISTRY}/php:${PHP_VERSION}-alpine${ALPINE_VERSION}

# Re-declare build args for use after FROM
ARG PHP_VERSION
ARG ALPINE_VERSION
ARG BUILD_DATE
ARG EXTENSION_NAME
ARG EXTENSION_VERSION
ARG TARGETARCH
ARG TARGETVARIANT

# OCI Image Labels
LABEL org.opencontainers.image.url="https://github.com/flavioheleno/php-ext-farm" \
      org.opencontainers.image.source="https://github.com/flavioheleno/php-ext-farm/blob/main/docker/Dockerfile.alpine" \
      org.opencontainers.image.created="${BUILD_DATE}" \
      org.opencontainers.image.title="PHP Extension: ${EXTENSION_NAME}" \
      org.opencontainers.image.description="Pre-compiled PHP extension ${EXTENSION_NAME} ${EXTENSION_VERSION} for ${TARGETARCH}${TARGETVARIANT}" \
      org.opencontainers.image.vendor="php-ext-farm" \
      org.opencontainers.image.licenses="MIT"

SHELL ["/bin/ash", "-eo", "pipefail", "-c"]

# Extension-specific ARGs
ARG EXTENSION_REPO_URL
ARG EXTENSION_BUILD_PATH=""
ARG BUILD_DEPS=""
ARG RUNTIME_DEPS=""
ARG EXTERNAL_LIBS=""
ARG CONFIGURE_OPTIONS=""

# Install extension-specific build and runtime dependencies
# hadolint ignore=DL3018
RUN if [ -n "${BUILD_DEPS}" ]; then \
      apk add --no-cache --virtual .ext-build-deps ${BUILD_DEPS}; \
    fi && \
    if [ -n "${RUNTIME_DEPS}" ]; then \
      apk add --no-cache ${RUNTIME_DEPS}; \
    fi

# Build external libraries if any
# hadolint ignore=DL3003
RUN if [ -n "${EXTERNAL_LIBS}" ]; then \
      echo "${EXTERNAL_LIBS}" > /tmp/external_libs.json && \
      jq -c '.[]' /tmp/external_libs.json | while read -r lib; do \
        LIB_NAME=$(echo "${lib}" | jq -r '.name'); \
        LIB_TYPE=$(echo "${lib}" | jq -r '.type'); \
        LIB_REPO=$(echo "${lib}" | jq -r '.repo_url'); \
        LIB_VERSION=$(echo "${lib}" | jq -r '.version // ""'); \
        echo "Building external library: ${LIB_NAME} (${LIB_TYPE})"; \
        cd /tmp && \
        git clone --depth 1 ${LIB_VERSION:+--branch ${LIB_VERSION}} "${LIB_REPO}" "${LIB_NAME}" && \
        cd "${LIB_NAME}" && \
        echo "${lib}" | jq -r '.build_commands[]' | while read -r cmd; do \
          echo "Running: ${cmd}"; \
          eval "${cmd}"; \
        done && \
        cd /tmp && \
        rm -rf "${LIB_NAME}"; \
      done; \
    fi

# Clone, build, install, verify, and cleanup in single layer
WORKDIR /tmp/extension
# hadolint ignore=DL3003
RUN git clone --depth 1 --recurse-submodules ${EXTENSION_VERSION:+--branch ${EXTENSION_VERSION}} "${EXTENSION_REPO_URL}" . && \
    if [ -n "${EXTENSION_BUILD_PATH}" ]; then cd "${EXTENSION_BUILD_PATH}"; fi && \
    phpize && \
    ./configure ${CONFIGURE_OPTIONS} && \
    make -j"$(nproc)" && \
    make install && \
    echo "extension=${EXTENSION_NAME}.so" > /usr/local/etc/php/conf.d/50-${EXTENSION_NAME}.ini && \
    php -m | grep -i "${EXTENSION_NAME}" && \
    EXT_DIR=$(php -r "echo ini_get('extension_dir');") && \
    mkdir -p /output/extension /output/libs && \
    cp "${EXT_DIR}/${EXTENSION_NAME}.so" /output/extension/ && \
    if [ -n "${EXTERNAL_LIBS}" ]; then \
      echo "Copying external libraries..." && \
      find /usr/local/lib -name '*.so*' -type f -exec cp -P {} /output/libs/ \; 2>/dev/null || true && \
      find /usr/local/lib -name '*.dylib*' -type f -exec cp -P {} /output/libs/ \; 2>/dev/null || true; \
    fi && \
    if [ -n "${BUILD_DEPS}" ]; then apk del .ext-build-deps; fi && \
    rm -rf /tmp/extension
